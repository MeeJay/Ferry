# ── Ferry ───────────────────────────────────────────────────────────────────
# Copy to .env and adjust. Everything else (SSO, mail, S3, limits, branding,
# link formats) is configured from the admin UI and stored in the database.

# Public URL as seen by users, without trailing slash. Used for SSO redirect,
# ShareX/e-mail links. Strongly recommended behind a reverse proxy.
APP_URL=https://share.example.com

# Port published by the client container (point your reverse proxy at it).
LISTEN_PORT=8080

# Database password (bundled postgres) — change it before the first start.
DB_PASSWORD=changeme
# Only with docker-compose.external-db.yml:
# DATABASE_URL=postgres://ferry:password@db-host:5432/ferry

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Initial local administrator, created on first start only.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Proxies allowed to set X-Forwarded-* (client IP, https detection).
# Express syntax: loopback, linklocal, uniquelocal, or IP/CIDR list.
TRUSTED_PROXIES=loopback, linklocal, uniquelocal

# Resumable upload chunk size (MB). Keep it under your proxy's body limit
# (Cloudflare free plan: 100 MB).
UPLOAD_CHUNK_MB=50

# Files volume: named volume by default, or a host path (e.g. /mnt/storage/ferry).
# DATA_PATH=ferry_data

# Image tag to deploy.
FERRY_VERSION=latest
